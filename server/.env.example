DATABASE_URL=postgresql://user:pass@host:5432/crowdcast
SOLANA_RPC_URL=https://api.devnet.solana.com
# Base58-encoded secret key of the authority wallet used to resolve markets
RESOLVER_KEYPAIR=<base58-encoded-secret-key>
# Bearer token for POST /resolve authentication
RESOLVER_SECRET=change-me-random-string
PORT=3001
# Base URL of this server (used by the Next.js frontend)
BACKEND_URL=http://localhost:3001
